# 网站：复制至 apps/web/.env.local；公开变量会进入浏览器包
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 仅云端服务使用，绝不可冠以 NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
APP_URL=http://localhost:3000
# Worker：复制至 apps/worker/.env；生产必须使用 HTTPS
CLOUD_API_BASE_URL=
WORKER_ID=
WORKER_API_TOKEN=
COMFYUI_BASE_URL=http://127.0.0.1:8188
POLL_INTERVAL_SECONDS=5
MAX_CONCURRENT_JOBS=1
IMAGE_GENERATION_ENABLED=0
# 相对路径以 Worker 启动时的当前目录为准
WORKFLOW_DIRECTORY=../../workflows
WORKER_STATE_DIRECTORY=./worker-state

# 个人私网生图验证模式（不适用于 Vercel）
MVP_LOCAL_ENABLED=0
MVP_ALLOWED_ORIGIN=
MVP_WORKER_TOKEN=
MVP_IMAGE_GENERATION_ENABLED=0
# 隔离开发可使用 3100；默认仍为 3000，仅允许回环地址
MVP_LOCAL_PORT=3000
# 默认 apps/web/.local-data/mvp.sqlite；相对路径以网页启动目录为准
MVP_DATABASE_PATH=.local-data/mvp.sqlite
# 服务端审核工作流目录，绝不从浏览器接受路径
MVP_WORKFLOW_DIRECTORY=../../workflows

# H3：同机部署使用 http://127.0.0.1:8189；远端使用 Tailscale HTTPS
# 留空时仅运行图片任务
H3_COMFYUI_BASE_URL=

# 可选的其他精确 HTTPS Origin，逗号分隔；例如保留旧私网端口
MVP_ALLOWED_ORIGINS=
