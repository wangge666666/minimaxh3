{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "H3 workflow capabilities v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "defaultEngine",
    "engines",
    "parameters",
    "assets",
    "defaults"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "defaultEngine": {
      "const": "native"
    },
    "engines": {
      "type": "object",
      "required": [
        "native",
        "director"
      ],
      "additionalProperties": false,
      "properties": {
        "native": {
          "$ref": "#/$defs/engine"
        },
        "director": {
          "$ref": "#/$defs/engine"
        }
      }
    },
    "parameters": {
      "type": "object",
      "required": [
        "fps",
        "steps",
        "durationSeconds",
        "frames",
        "dimensions",
        "canvasAlignment",
        "seed",
        "refImageSize",
        "ratios",
        "resolutions"
      ]
    },
    "assets": {
      "type": "object",
      "required": [
        "h3_t2v",
        "h3_i2v",
        "h3_r2v",
        "uploadLimits"
      ]
    },
    "defaults": {
      "type": "object",
      "required": [
        "steps",
        "durationSeconds",
        "frames",
        "fps",
        "sound",
        "referenceVideoAudio",
        "refImageSize"
      ]
    }
  },
  "$defs": {
    "engine": {
      "type": "object",
      "required": [
        "status",
        "modes"
      ],
      "properties": {
        "status": {
          "enum": [
            "baseline",
            "candidate",
            "gpu-validated"
          ]
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "builderRevision": {
          "type": "string"
        },
        "builderFilesSha256": {
          "$ref": "#/$defs/hashes"
        },
        "modes": {
          "type": "object",
          "required": [
            "h3_t2v",
            "h3_i2v",
            "h3_r2v"
          ],
          "additionalProperties": false,
          "properties": {
            "h3_t2v": {
              "$ref": "#/$defs/mode"
            },
            "h3_i2v": {
              "$ref": "#/$defs/mode"
            },
            "h3_r2v": {
              "$ref": "#/$defs/mode"
            }
          }
        }
      }
    },
    "hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "mode": {
      "type": "object",
      "required": [
        "available",
        "revision",
        "template",
        "mapping",
        "fileSha256",
        "outputNodeIds",
        "outputKind",
        "checkpointFamily",
        "validation"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "type": "string",
          "pattern": "^h3_(director_)?(t2v|i2v|r2v)_api\\.json$"
        },
        "mapping": {
          "type": "string",
          "pattern": "^h3_(director_)?(t2v|i2v|r2v)_mapping\\.json$"
        },
        "fileSha256": {
          "$ref": "#/$defs/hashes"
        },
        "outputNodeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "8",
              "92"
            ]
          }
        },
        "outputKind": {
          "const": "video"
        },
        "checkpointFamily": {
          "enum": [
            "fl2va",
            "ref2va"
          ]
        },
        "validation": {
          "type": "object",
          "required": [
            "level",
            "profiles"
          ],
          "properties": {
            "level": {
              "enum": [
                "baseline",
                "pending",
                "gpu-smoke"
              ]
            },
            "profiles": {
              "type": "array"
            }
          }
        }
      }
    }
  }
}
